# Copy this to .env for local dev (vercel dev picks it up automatically).
# In production, set these as environment variables in your Vercel project settings instead.
GEMINI_API_KEY=your_gemini_api_key_here

# From elevenlabs.io — Profile → API Keys.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional — defaults to "Louis" (b5Ggo9o15QPFEkYe1Mui) if unset. Find other
# voice IDs at elevenlabs.io/app/voice-library.
ELEVENLABS_VOICE_ID=
