# Copy this to .env for local dev (vercel dev picks it up automatically).
# In production, set these as environment variables in your Vercel project settings instead.
GEMINI_API_KEY=your_gemini_api_key_here

# From elevenlabs.io — Profile → API Keys.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional — defaults to TX3LPaxmHKxFdv7VOQHJ if unset. Note: Voice Library
# voices need a paid ElevenLabs plan to use via the API — on the free tier,
# stick to your account's premade/default voices.
ELEVENLABS_VOICE_ID=
